<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.10.2</Version>
    <ApplicationIcon>icons\feldbuch.ico</ApplicationIcon>
    <Authors>Johann Gerner</Authors>
    <Company>Johann Gerner</Company>
    <Copyright>© 2026 Johann Gerner</Copyright>
    <Description>Geodätisches Feldbuch mit Tachymeteranbindung und DXF-Viewer</Description>
  </PropertyGroup>

  <!-- Release: keine Debug-Symbole, optimierter Code -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- Buildzähler: erhöht BuildNummer.txt nur, wenn sich Quellcode oder Projektdatei geändert haben -->
  <Target Name="BuildNummerErhoehen"
          Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="@(Compile);$(MSBuildProjectFullPath)"
          Outputs="$(IntermediateOutputPath)BuildNummer.stamp">
    <PropertyGroup>
      <_BuildNummerAlt Condition="Exists('BuildNummer.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\BuildNummer.txt').Trim())</_BuildNummerAlt>
      <_BuildNummerAlt Condition="'$(_BuildNummerAlt)' == ''">0</_BuildNummerAlt>
      <_BuildNummerNeu>$([MSBuild]::Add($(_BuildNummerAlt), 1))</_BuildNummerNeu>
    </PropertyGroup>
    <WriteLinesToFile File="BuildNummer.txt" Lines="$(_BuildNummerNeu)" Overwrite="true" />
    <Touch Files="$(IntermediateOutputPath)BuildNummer.stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="BuildNummerEinbetten"
          DependsOnTargets="BuildNummerErhoehen"
          BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <_BuildNummer Condition="Exists('BuildNummer.txt')">$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\BuildNummer.txt').Trim())</_BuildNummer>
      <_BuildNummer Condition="'$(_BuildNummer)' == ''">0</_BuildNummer>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyMetadata Include="BuildNummer" Value="$(_BuildNummer)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="9.0.0" />
    <PackageReference Include="System.Management" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="icons\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>icons\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Content Include="prismenkonstanten.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Muster.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="FreieStationierung_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Polarpunkte_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="KoordTransformation_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Rueckwaertsschnitt_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Vorwaertsschnitt_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Bogenschnitt_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Hochpunktherablegung_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Punktabsteckung_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Achsabsteckung_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Schnurgeruest_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Rasterabsteckung_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Profilabsteckung_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Flächenteilung_Protokoll.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>